<?xml version="1.0" ?>
<!--
  Minimal test world for Gazebo Harmonic (gz-sim), ROS 2 Jazzy.

  Retains the Chunk 3 physics, lighting, ground plane, and two static walls
  for collision and sensor testing. Chunk 4 adds sensor systems, not rooms or
  corridors. NO rooms, corridors, or
  surveillance zones (those belong to a later chunk).

  The four system plugins are the standard gz-sim set required for a spawned,
  ros2_control-driven robot:
    physics           - runs the dynamics (DART engine)
    user-commands     - lets ros_gz_sim `create` spawn entities into the world
    scene-broadcaster - streams scene state to the GUI / other tools
    contact           - enables contact reporting used by collision surfaces
-->
<sdf version="1.10">
  <world name="test_world">

    <!-- Reasonable, lightweight physics timestep (spec sections 14, 33). -->
    <physics name="default_physics" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system"
            name="gz::sim::systems::Contact"/>

    <!-- Rendering-based LiDAR/camera and physics-based IMU use separate systems. -->
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu"/>

    <gravity>0 0 -9.81</gravity>

    <!-- Lighting. -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.8 1</background>
      <grid>false</grid>
    </scene>

    <!-- Ground plane: flat, high-friction, infinite collision. -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>50 50</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>50 50</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.3 0.3 0.3 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Two static walls for optional collision testing (spec section 11). -->
    <model name="wall_front">
      <static>true</static>
      <pose>3.0 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.2 4.0 1.0</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.2 4.0 1.0</size></box>
          </geometry>
          <material>
            <ambient>0.6 0.3 0.2 1</ambient>
            <diffuse>0.7 0.4 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_left">
      <static>true</static>
      <pose>0 3.0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>6.0 0.2 1.0</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>6.0 0.2 1.0</size></box>
          </geometry>
          <material>
            <ambient>0.6 0.3 0.2 1</ambient>
            <diffuse>0.7 0.4 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
