<?xml version="1.0"?>
<!--
  Central parameter file for the surveillance robot.

  Change a value here and the whole model updates consistently. Nothing else
  in the description should hardcode a dimension that belongs in this file.

  ALL VALUES ARE PROVISIONAL ENGINEERING ASSUMPTIONS (SI units: metres / kg).
  Replace them with real specifications when available.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ================= CHASSIS ================= -->
  <xacro:property name="chassis_length" value="0.50"/>   <!-- x, forward  -->
  <xacro:property name="chassis_width"  value="0.40"/>   <!-- y, left     -->
  <xacro:property name="chassis_height" value="0.20"/>   <!-- z, up       -->
  <xacro:property name="chassis_mass"   value="15.0"/>

  <!-- Distance from the ground to the bottom face of the chassis. -->
  <xacro:property name="ground_clearance" value="0.05"/>

  <!-- ================= WHEELS ================= -->
  <xacro:property name="wheel_radius" value="0.10"/>
  <xacro:property name="wheel_width"  value="0.05"/>
  <xacro:property name="wheel_mass"   value="1.0"/>

  <!--
    Track width = distance between the two wheel contact planes.
    Wheels are mounted just outboard of the chassis side walls:
      chassis_width/2 + wheel_width/2 = 0.20 + 0.025 = 0.225 per side.
  -->
  <xacro:property name="wheel_separation" value="0.45"/>

  <!--
    Vertical offset from base_link to the wheel axis.
    base_link sits at wheel-axis height, so wheels rotate about base_link z = 0.
  -->
  <xacro:property name="wheel_zoff" value="0.0"/>

  <!-- ================= SENSOR MOUNTS ================= -->
  <!-- Heights are given relative to base_link (wheel-axis height). -->

  <!-- LiDAR: centred, slightly forward, on top of the chassis. -->
  <xacro:property name="laser_x" value="0.15"/>
  <xacro:property name="laser_y" value="0.0"/>
  <xacro:property name="laser_z" value="0.20"/>

  <!-- Camera: front face of the chassis, facing forward (+x). -->
  <xacro:property name="camera_x" value="0.25"/>
  <xacro:property name="camera_y" value="0.0"/>
  <xacro:property name="camera_z" value="0.10"/>

  <!-- IMU: near the chassis centre of mass. -->
  <xacro:property name="imu_x" value="0.0"/>
  <xacro:property name="imu_y" value="0.0"/>
  <xacro:property name="imu_z" value="0.05"/>

  <!-- ================= MATH HELPERS ================= -->
  <xacro:property name="PI"      value="3.14159265358979"/>
  <xacro:property name="PI_2"    value="1.57079632679489"/>

</robot>
