<?xml version="1.0"?>
<!--
  base_footprint -> base_link -> chassis body.

  base_footprint : ground-projected 2D navigation reference. It remains on the
                   floor directly below the robot.
  base_link      : main kinematic reference at wheel-axis height.

  The GLB below is visual-only. Existing collision geometry, inertial values,
  wheel joints, TF frames, and ros2_control configuration remain unchanged.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Ground-projected 2D navigation reference. -->
  <link name="base_footprint"/>

  <!-- Lift base_link from the ground to the wheel-axis height. -->
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
  </joint>

  <!-- Kinematic reference frame; chassis geometry is attached below. -->
  <link name="base_link"/>

  <!-- Chassis center relative to base_link. -->
  <xacro:property
    name="chassis_zoff"
    value="${ground_clearance - wheel_radius + chassis_height / 2.0}"/>

  <joint name="chassis_joint" type="fixed">
    <parent link="base_link"/>
    <child link="chassis_link"/>
    <origin xyz="0 0 ${chassis_zoff}" rpy="0 0 0"/>
  </joint>

  <link name="chassis_link">

    <!--
      Visual-only robot appearance.

      The supplied GLB is fitted to the existing 0.50 m chassis with an initial
      uniform scale of 0.25. Adjust only this visual origin/scale after checking
      it in Gazebo; do not alter the collision model or robot frames to fit it.
    -->
    <visual>
      <origin xyz="0 0 0.15" rpy="0 0 0"/>
      <geometry>
        <mesh
          filename="package://surveillance_robot_description/meshes/surveillance_robot.glb"
          scale="0.25 0.25 0.25"/>
      </geometry>
    </visual>

    <!-- Preserve the existing physical collision envelope. -->
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
    </collision>

    <!-- Preserve the existing mass and inertial model. -->
    <xacro:inertial_box
      mass="${chassis_mass}"
      x="${chassis_length}"
      y="${chassis_width}"
      z="${chassis_height}">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:inertial_box>

  </link>

</robot>
