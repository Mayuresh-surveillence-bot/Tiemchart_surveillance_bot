<?xml version="1.0"?>
<!--
  STRUCTURAL sensor mounting frames only. Gazebo sensors and topic configuration
  live separately in surveillance_robot_gazebo/urdf/gazebo_sensors.xacro and are
  attached only when sim_mode is enabled.

  Frame conventions (REP 103): x = forward, y = left, z = up.

  laser_link  : upright, axes aligned with base_link (LiDAR scans in its xy).
  camera_link : mounting frame aligned with base_link, +x forward. Its optical
                child uses z-forward, x-right, y-down for ROS camera messages.
  imu_link    : aligned with base_link.

  Small visual markers are included purely so the mounts are visible in RViz.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ================= LiDAR mount ================= -->
  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="laser_link"/>
    <origin xyz="${laser_x} ${laser_y} ${laser_z}" rpy="0 0 0"/>
  </joint>

  <link name="laser_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.04" length="0.04"/>
      </geometry>
      <material name="laser_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.04" length="0.04"/>
      </geometry>
    </collision>
    <xacro:inertial_cylinder mass="0.1" radius="0.04" length="0.04">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:inertial_cylinder>
  </link>

  <!-- ================= Camera mount ================= -->
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="camera_link"/>
    <origin xyz="${camera_x} ${camera_y} ${camera_z}" rpy="0 0 0"/>
  </joint>

  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.09 0.03"/>
      </geometry>
      <material name="camera_green"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.09 0.03"/>
      </geometry>
    </collision>
    <xacro:inertial_box mass="0.1" x="0.03" y="0.09" z="0.03">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:inertial_box>
  </link>

  <!-- The optical origin is co-located with the mount: +z forward, +x right,
       +y down. robot_state_publisher is the only publisher of this fixed TF. -->
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="${-PI_2} 0 ${-PI_2}"/>
  </joint>
  <link name="camera_optical_frame"/>

  <!-- ================= IMU mount ================= -->
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="imu_link"/>
    <origin xyz="${imu_x} ${imu_y} ${imu_z}" rpy="0 0 0"/>
  </joint>

  <link name="imu_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.03 0.01"/>
      </geometry>
      <material name="imu_orange"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.03 0.01"/>
      </geometry>
    </collision>
    <xacro:inertial_box mass="0.05" x="0.03" y="0.03" z="0.01">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:inertial_box>
  </link>

</robot>
