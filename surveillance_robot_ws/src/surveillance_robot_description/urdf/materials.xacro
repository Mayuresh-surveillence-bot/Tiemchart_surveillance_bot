<?xml version="1.0"?>
<!--
  Reusable named materials for RViz visualisation. Colours are chosen only for
  clear geometric identification, not for realistic rendering.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <material name="chassis_grey">
    <color rgba="0.30 0.32 0.35 1.0"/>
  </material>

  <material name="wheel_black">
    <color rgba="0.10 0.10 0.10 1.0"/>
  </material>

  <material name="laser_blue">
    <color rgba="0.10 0.35 0.85 1.0"/>
  </material>

  <material name="camera_green">
    <color rgba="0.15 0.65 0.25 1.0"/>
  </material>

  <material name="imu_orange">
    <color rgba="0.90 0.50 0.10 1.0"/>
  </material>

  <material name="white">
    <color rgba="1.0 1.0 1.0 1.0"/>
  </material>

</robot>
