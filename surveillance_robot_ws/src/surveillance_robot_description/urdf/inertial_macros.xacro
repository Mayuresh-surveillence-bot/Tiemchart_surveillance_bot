<?xml version="1.0"?>
<!--
  Reusable inertial macros using physically meaningful formulas for solid
  primitives of uniform density. All produce mass > 0 and a valid, positive
  definite inertia tensor.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    Solid box inertia about its geometric centre.
      x, y, z = full side lengths along each axis.
    Ixx = 1/12 m (y^2 + z^2), etc.
  -->
  <xacro:macro name="inertial_box" params="mass x y z *origin">
    <inertial>
      <xacro:insert_block name="origin"/>
      <mass value="${mass}"/>
      <inertia
        ixx="${(1.0/12.0) * mass * (y*y + z*z)}"
        ixy="0.0"
        ixz="0.0"
        iyy="${(1.0/12.0) * mass * (x*x + z*z)}"
        iyz="0.0"
        izz="${(1.0/12.0) * mass * (x*x + y*y)}"/>
    </inertial>
  </xacro:macro>

  <!--
    Solid cylinder inertia. The cylinder's symmetry axis is +z in its own
    frame (length h along z). Callers that mount a wheel with its axis along y
    supply an <origin> rpy that rotates the whole inertial block accordingly.
      Ixx = Iyy = 1/12 m (3 r^2 + h^2)
      Izz = 1/2 m r^2
  -->
  <xacro:macro name="inertial_cylinder" params="mass radius length *origin">
    <inertial>
      <xacro:insert_block name="origin"/>
      <mass value="${mass}"/>
      <inertia
        ixx="${(1.0/12.0) * mass * (3.0*radius*radius + length*length)}"
        ixy="0.0"
        ixz="0.0"
        iyy="${(1.0/12.0) * mass * (3.0*radius*radius + length*length)}"
        iyz="0.0"
        izz="${(1.0/2.0) * mass * radius*radius}"/>
    </inertial>
  </xacro:macro>

  <!--
    Solid sphere inertia about its centre.
      Ixx = Iyy = Izz = 2/5 m r^2
  -->
  <xacro:macro name="inertial_sphere" params="mass radius *origin">
    <inertial>
      <xacro:insert_block name="origin"/>
      <mass value="${mass}"/>
      <inertia
        ixx="${(2.0/5.0) * mass * radius*radius}"
        ixy="0.0"
        ixz="0.0"
        iyy="${(2.0/5.0) * mass * radius*radius}"
        iyz="0.0"
        izz="${(2.0/5.0) * mass * radius*radius}"/>
    </inertial>
  </xacro:macro>

</robot>
