<?xml version="1.0"?>
<!--
  Left and right drive wheels for a two-wheel differential-drive base.

  Each wheel is a cylinder whose symmetry axis is rotated to lie along the
  robot's y-axis (left). The revolute joints spin about y (axis 0 1 0) and are
  structurally ready for a future diff-drive controller. No ros2_control here.

  A continuous joint is used (unlimited rotation) which is the correct type for
  a freely spinning drive wheel.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    reflect = +1 for the left wheel, -1 for the right wheel.
    The cylinder is rotated by -PI/2 about x so its z-axis (length) points
    along +y; the inertial block is rotated the same way so the tensor matches.
  -->
  <xacro:macro name="wheel" params="prefix reflect">
    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child  link="${prefix}_wheel_link"/>
      <origin xyz="0 ${reflect * wheel_separation/2.0} ${wheel_zoff}"
              rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>

    <link name="${prefix}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="${-PI_2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="wheel_black"/>
      </visual>

      <collision>
        <origin xyz="0 0 0" rpy="${-PI_2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>

      <xacro:inertial_cylinder mass="${wheel_mass}"
                               radius="${wheel_radius}" length="${wheel_width}">
        <origin xyz="0 0 0" rpy="${-PI_2} 0 0"/>
      </xacro:inertial_cylinder>
    </link>
  </xacro:macro>

  <xacro:wheel prefix="left"  reflect="1"/>
  <xacro:wheel prefix="right" reflect="-1"/>

</robot>
